STYLE_SETTINGS_CSS=body.css-settings-manager { --tag-border-width: 1px; --anp-rainbow-folder-bg-opacity: 0.7; } body.theme-light.css-settings-manager { } body.theme-dark.css-settings-manager { }
STYLE_SETTINGS_BODY_CLASSES=theme-dark mod-windows is-frameless is-hidden-frameless obsidian-app styled-scrollbars show-inline-title show-ribbon show-view-header is-maximized is-focused css-settings-manager anp-td-none ctp-latte ctp-mocha-old ctp-accent-peach anuppuccin-accent-toggle anp-current-line anp-latex-inline-text anp-latex-block-text anp-list-toggle anp-hide-external-link-icon anp-h1-red anp-h2-peach anp-h3-green anp-h4-teal anp-h5-lavender anp-h6-mauve anp-bold-red anp-italic-green anp-highlight-yellow anp-full-rainbow-color-toggle anp-default-tab
USE_FULL_RESOLUTION_IMAGES=false
THEME=https://raw.githubusercontent.com/Quinta0/Aurora-Twilight/HEAD/theme.css
BASE_THEME=dark
dgHomeLink=true
dgPassFrontmatter=false
dgShowBacklinks=true
dgShowLocalGraph=true
dgShowInlineTitle=true
dgShowFileTree=true
