<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}My Digital Garden{% endblock %}</title>
  
  <!-- Optional theme CSS -->
  <link rel="stylesheet" href="/styles/_theme.css">
</head>
<body>
  <!-- Header -->
  <header>
    <h1><a href="/">My Digital Garden</a></h1>
    <nav>
      <a href="/">Home</a>
      <a href="/categories/">Categories</a>
    </nav>
  </header>

  <!-- Main Content -->
  <main>
    {% block content %}{% endblock %}
  </main>

  <!-- Footer -->
  <footer>
    <p>© {{ "now" | date("yyyy") }} My Digital Garden</p>
  </footer>

  <!-- Optional Scripts -->
  <script src="/scripts/main.js"></script>
</body>
</html>
